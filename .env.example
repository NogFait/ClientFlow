# ---------------------------------------------------------------------------
# Cliente (Vite) — se hornean en el bundle en build time. NUNCA secretos acá.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
# Muestra la UI de planes/facturación y habilita el checkout en el servidor.
VITE_BILLING_ENABLED=false
# Sentry (monitoreo de errores). El DSN es público por diseño; vacío = apagado
# (local, tests). En Vercel: Production y Preview.
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Servidor (Vercel Functions en api/) — solo en Vercel (Production/Preview) o
# en `vercel dev`. Sin prefijo VITE_: nunca llegan al navegador.
# ---------------------------------------------------------------------------
# Polar: `sandbox` para desarrollo/QA (sandbox.polar.sh), `production` al lanzar.
POLAR_SERVER=sandbox
# Token de organización de Polar (scopes: checkouts:write, customers:read/write,
# customer_sessions:write, subscriptions:read, products:read).
POLAR_ACCESS_TOKEN=
# Secret del endpoint de webhook (formato whsec_...), uno por entorno de Polar.
POLAR_WEBHOOK_SECRET=
# IDs de producto en Polar para cada plan pago.
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
# Supabase con service role: solo lo usa el webhook/checkout del lado servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Sentry: subida de source maps en el build de Vercel (sin esto, el build no
# sube nada y sigue andando). Token con scope project:releases + org:read.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=clientflow-xq
SENTRY_PROJECT=clientflow
